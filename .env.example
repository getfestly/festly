# ============================================================================
# FESTLY — Umgebungsvariablen (Vorlage)
# ============================================================================
# 1. Kopiere diese Datei zu ".env.local"
# 2. Trage deine echten Werte ein
# 3. NIEMALS echte Schlüssel in Git committen! (.env.local steht in .gitignore)
# ============================================================================

# --- Supabase (Projekt → Settings → API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://DEINPROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# --- Stripe (Dashboard → Entwickler → API-Schlüssel) -----------------------
# Test-Keys:  sk_test_... / pk_test_...
# Live-Keys:  sk_live_... / pk_live_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook-Secret (Dashboard → Entwickler → Webhooks → Signing Secret)
# Lokal:        stripe listen --forward-to localhost:3000/api/stripe/webhook
# Produktion:   https://festly.de/api/stripe/webhook (neuen Webhook anlegen!)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (resend.com → API Keys) -----------------------------------------
RESEND_API_KEY=re_...
# Absender-Adresse (muss in Resend verifiziert sein)
EMAIL_FROM=Festly <noreply@festly.de>

# --- App-URL (ohne trailing slash) ------------------------------------------
# Lokal:       http://localhost:3000
# Produktion:  https://festly.de
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron-Secret (Vercel Cron Jobs → automatisch injiziert) -----------------
# Generiere einen zufälligen String: openssl rand -hex 32
CRON_SECRET=dein-zufaelliger-geheimer-string

# --- Sentry Error Monitoring (sentry.io → Projekt → Settings → DSN) --------
# Kostenloser Plan ausreichend für den Start
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Optional: für Source-Map-Uploads (sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=sntrys_...
