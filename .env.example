# ============================================================================
# FESTLY — Umgebungsvariablen (Vorlage)
# ============================================================================
# Kopiere diese Datei zu ".env.local" und trage deine echten Werte ein.
# NIEMALS echte Schlüssel in Git committen! (.env.local steht in .gitignore)
# ============================================================================

# --- Supabase (aus deinem Supabase-Projekt -> Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://DEINPROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# --- Stripe (aus deinem Stripe-Dashboard -> Entwickler -> API-Schlüssel) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App ---
APP_URL=http://localhost:3000
